{
  "name": "pdf-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && vite --host 127.0.0.1",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src tests scripts vite.config.js eslint.config.js --max-warnings=0",
    "format": "prettier --write src/*.{js,jsx} tests/*.mjs scripts/*.mjs vite.config.js eslint.config.js",
    "format:check": "prettier --check src/*.{js,jsx} tests/*.mjs scripts/*.mjs vite.config.js eslint.config.js"
  },
  "dependencies": {
    "lucide-react": "1.67.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  }
}
